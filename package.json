{
  "name": "alttp-tracker-window",
  "productName": "ALttP Tracker",
  "version": "1.2.0",
  "description": "Muffins tracker and Stonks timer in one window",
  "main": "main.js",
  "author": "CVW-HMB",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "install-app": "./scripts/install.sh",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/CVW-HMB/alttp-tracker-window",
  "repository": {
    "type": "git",
    "url": "https://github.com/CVW-HMB/alttp-tracker-window.git"
  },
  "build": {
    "appId": "io.github.cvwhmb.alttptracker",
    "productName": "ALttP Tracker",
    "files": [
      "main.js",
      "package.json",
      "ui/**",
      "inject/**",
      "vendor/z3rTracker/**",
      "!vendor/z3rTracker/tools/**"
    ],
    "directories": {
      "output": "dist.nosync",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-1024.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ALttP-Tracker-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "ALttP-Tracker-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "ALttP-Tracker-${version}-mac-arm64.zip"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  }
}
